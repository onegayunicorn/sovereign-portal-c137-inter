{
  "name": "Rick C-137 Portal Interface // Twin Portal",
  "short_name": "Portal C-137",
  "id": "/",
  "description": "Sovereign Offline AI Twin Portal & Dimension Orchestrator",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#010804",
  "theme_color": "#00FF88",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities", "productivity", "ai"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open AI Converter",
      "short_name": "Convert",
      "description": "Convert a raw HTML file into an installable offline PWA.",
      "url": "/convert",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Telemetry Snapshot",
      "short_name": "Telemetry",
      "description": "Transmit the current dimension telemetry snapshot via Gist.",
      "url": "/?action=telemetry",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/convert",
      "accept": {
        "text/html": [".html", ".htm"]
      }
    }
  ]
