<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31): android:dataExtractionRules for backup + device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="sovereign_secure_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="sovereign_secure_keys.xml" />
    </device-transfer>
</data-extraction-rules>
