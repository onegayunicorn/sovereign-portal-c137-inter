# ============================================================================
# Sovereign Portal C-137 — root environment schema
# Copy to `.env` and fill in. Never commit the real values.
# ============================================================================

# ----------------------------------------------------------------- runtime ---
NODE_ENV=development
PORT=4000
SOE_PORT=8000
SOE_HOST=127.0.0.1
COHERENCE_THRESHOLD=0.999
MERKLE_LOG_PATH=./data/merkle_audit.log

# -------------------------------------------------------- SOE gateway auth ---
# Sent by the portal HUD as the `X-API-Key` header on /orchestrate/action.
SOVEREIGN_API_KEY=sovereign-portal-c137
SOVEREIGN_SESSION_KEY=SOVEREIGN_SUPER_SECRET_HMAC_KEY_2026

# ------------------------------------------------------------- databases -----
# Prisma (PostgreSQL, cloud/relational authority)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sovereign_portal?schema=public
DIRECT_URL=postgresql://postgres:postgrespassword@localhost:5432/sovereign_portal?schema=public

# Local Drizzle (SQLite / libSQL edge target)
LOCAL_DATABASE_URL=file:./data/portal-local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --------------------------------------------------------- GitHub Gists ------
# Optional: enables "EXPORT STATE" to publish to a Gist instead of a local file.
GITHUB_GIST_TOKEN=
GITHUB_GIST_PUBLIC=false

# ------------------------------------------------------------------- AI ------
# Optional cloud TTS backends for the VoiceΩ subsystem. All inference paths
# fall back to local WebGPU/WASM when these are empty.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Local Ollama / vLLM runtime for the Rick C-137 persona core.
OLLAMA_HOST=http://127.0.0.1:11434
SOVEREIGN_MODEL=rick-c137:latest

# Where the quantized WebGPU weights live for the PWA.
NEXT_PUBLIC_WEBGPU_MODELS_URL=/models/
VITE_WEBGPU_MODELS_URL=/models/

# ------------------------------------------------------ Matrix federation ----
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_ROOM_ID=!dimension-c137:sovereign.mesh
MATRIX_ACCESS_TOKEN=
MATRIX_USER_ID=

# ------------------------------------------------------------ observability --
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
