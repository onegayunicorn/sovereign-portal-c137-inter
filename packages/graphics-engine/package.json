{
  "name": "@portal/graphics-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Sovereign Portal C-137 graphics engine: react-three-fiber portal gun GLB loader, audio-reactive accretion vortex and CRT post-processing stack.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./shaders/portal.frag": "./src/shaders/portal.frag"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.0",
    "@react-three/fiber": "^9.1.0",
    "@react-three/postprocessing": "^3.0.4",
    "postprocessing": "^6.36.4",
    "three": "^0.173.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/three": "^0.173.0",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "portal-c137",
    "three",
    "react-three-fiber",
    "webgl",
    "glb"
  ],
  "license": "MIT"
}
