{
  "name": "@portal/database",
  "version": "1.0.0",
  "description": "Sovereign Portal C-137 — dual ORM data layer (Prisma cloud + Drizzle local/edge)",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./prisma": "./src/prisma-client.ts",
    "./drizzle": "./src/drizzle-client.ts",
    "./drizzle/schema": "./drizzle/schema.ts",
    "./sync": "./src/sync-engine.ts"
  },
  "files": [
    "src",
    "drizzle",
    "prisma",
    ".env.example"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "drizzle:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@prisma/client": "^6.2.1",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.3"
  },
  "devDependencies": {
    "@portal/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "prisma": "^6.2.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
