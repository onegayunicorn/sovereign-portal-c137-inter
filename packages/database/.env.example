# =============================================================================
# @portal/database — environment schema
# Copy to `.env` at the repo root (or the consuming app) and fill in values.
# =============================================================================

# --- Cloud plane (Prisma / PostgreSQL) --------------------------------------
# Pooled connection used by the app runtime (PgBouncer / Prisma Accelerate).
DATABASE_URL="postgresql://portal_admin:SovereignPortalPassword2026!@localhost:5432/sovereign_portal?schema=public"
# Direct (non-pooled) connection used for migrations.
DIRECT_URL="postgresql://portal_admin:SovereignPortalPassword2026!@localhost:5432/sovereign_portal?schema=public"

# --- Local plane (Drizzle / SQLite) -----------------------------------------
# Path to the on-device SQLite database (desktop / portable / Tauri builds).
LOCAL_SQLITE_PATH="portal-c137.local.db"

# --- Edge plane (Drizzle / libSQL - Turso / Cloudflare) ----------------------
# Falls back to a local `file:` database when unset.
LIBSQL_URL="file:portal-c137.edge.db"
LIBSQL_AUTH_TOKEN=""

# --- Application ------------------------------------------------------------
NODE_ENV="development"
# GitHub Gist token used by @portal/gist-sync (leave blank for anonymous mode).
GITHUB_GIST_TOKEN=""
