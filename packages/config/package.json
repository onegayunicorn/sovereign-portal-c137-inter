{
  "name": "@portal/config",
  "version": "1.0.0",
  "private": true,
  "description": "Sovereign Portal C-137 shared build configuration: ESLint flat preset, Tailwind tokens preset and Vite config factory.",
  "type": "module",
  "main": "./vite-preset.js",
  "exports": {
    ".": "./vite-preset.js",
    "./eslint-preset": "./eslint-preset.js",
    "./tailwind-preset": "./tailwind-preset.js",
    "./vite-preset": "./vite-preset.js"
  },
  "files": [
    "eslint-preset.js",
    "tailwind-preset.js",
    "vite-preset.js",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"console.log('@portal/config is source-only; nothing to build.')\"",
    "lint": "eslint . --ext .js"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript": ">=5.5.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": { "optional": true },
    "typescript": { "optional": true },
    "vite": { "optional": true }
  },
  "keywords": [
    "portal-c137",
    "config",
    "eslint",
    "tailwind",
    "vite"
  ],
  "license": "MIT"
}
