{
  "name": "@portal/hud-overlay-system",
  "version": "1.0.0",
  "private": true,
  "description": "Sovereign Portal C-137 HUD overlay system: Reticle, ScanlineFilter, TelemetryCard, WaveformBar and TerminalPrompt (React 19).",
  "type": "module",
