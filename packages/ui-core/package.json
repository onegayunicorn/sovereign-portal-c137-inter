{
  "name": "@portal/ui-core",
  "version": "1.0.0",
  "private": true,
  "description": "Sovereign Portal C-137 shared design tokens and typed theme (CSS custom properties + TS constants).",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "keywords": [
    "portal-c137",
    "design-tokens",
    "theme",
    "css-variables"
  ],
  "license": "MIT"
}
